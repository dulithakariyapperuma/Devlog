# ── Environment ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Local development:
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/devlog_db"
# Railway production (will be given to you by Railway):
# DATABASE_URL="postgresql://user:pass@host:port/dbname"

# JWT secret - use a long random string (at least 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Port for the server
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ── Super Admin Seed ──────────────────────────────────────────
# Used only when running: npm run db:seed
# This creates the first ever super admin account
SEED_ADMIN_EMAIL="admin@devlog.io"
SEED_ADMIN_PASSWORD="ChangeThisPassword123!"
SEED_ADMIN_NAME="Super Admin"
