// ─────────────────────────────────────────────────────────────────────────────
// Devlog Live Feed — Prisma Schema
// Multi-team knowledge sharing platform
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Role Enums ────────────────────────────────────────────────────────────────
enum OrgRole {
  SUPER_ADMIN  // Global platform admin
  ORG_OWNER
  ORG_ADMIN
  ORG_MEMBER
}

enum TeamRole {
  TEAM_OWNER
  TEAM_ADMIN
  TEAM_MEMBER
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatar       String?                              // 2-letter initials, e.g. "DK"
  
  // Kept for backward compatibility or global platform access
  globalRole   String?    @map("global_role")       // e.g. "SUPER_ADMIN"

  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  orgMemberships OrgMembership[]
  teamMemberships TeamMembership[]
  projectMembers  ProjectMember[]
  entries         SolutionEntry[]
  assignedBugs    BugReport[]      @relation("assignee")
  reportedBugs    BugReport[]      @relation("reporter")
  knowledgeLinks  KnowledgeLink[]
  messages        ChatMessage[]
  createdInvites  Invite[]         @relation("created_invites")

  @@map("users")
}

// ── Organizations ─────────────────────────────────────────────────────────────
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  memberships OrgMembership[]
  teams       Team[]
  invites     Invite[]

  @@map("organizations")
}

// ── Org Memberships ───────────────────────────────────────────────────────────
model OrgMembership {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(ORG_MEMBER)
  joinedAt       DateTime @default(now()) @map("joined_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

// ── Teams ─────────────────────────────────────────────────────────────────────
model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String   @unique                      // URL-friendly, e.g. "intern-batch-2025"
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    TeamMembership[]
  projects       Project[]
  knowledgeLinks KnowledgeLink[]
  invites        Invite[]

  @@map("teams")
}

// ── Team Memberships ──────────────────────────────────────────────────────────
model TeamMembership {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(TEAM_MEMBER)
  status   String   @default("online")             // "online" | "away" | "offline"
  joinedAt DateTime @default(now()) @map("joined_at")

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])                       // One membership per user per team
  @@map("team_memberships")
}

// ── Invites ───────────────────────────────────────────────────────────────────
model Invite {
  id             String   @id @default(uuid())
  tokenHash      String   @unique @map("token_hash")
  organizationId String   @map("organization_id")
  teamId         String?  @map("team_id")            // Null means Org-level invite
  role           String                                // E.g., "ORG_MEMBER", "TEAM_ADMIN"
  status         String   @default("active")         // "active", "accepted", "expired", "revoked"
  expiresAt      DateTime @map("expires_at")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("created_invites", fields: [createdById], references: [id], onDelete: Cascade)
  
  @@map("invites")
}

// ── Projects ──────────────────────────────────────────────────────────────────
// Projects belong to a team. Only team members can see them.
model Project {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  name        String
  description String?
  status      String    @default("active")         // "active" | "completed"
  startDate   DateTime  @map("start_date")         @db.Date
  endDate     DateTime? @map("end_date")           @db.Date
  createdAt   DateTime  @default(now())            @map("created_at")

  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  entries     SolutionEntry[]
  bugs        BugReport[]
  messages    ChatMessage[]

  @@map("projects")
}

// ── Project Members ───────────────────────────────────────────────────────────
// Which team members are assigned to which project.
model ProjectMember {
  projectId String @map("project_id")
  memberId  String @map("member_id")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [memberId],  references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
  @@map("project_members")
}

// ── Solution Entries ──────────────────────────────────────────────────────────
// The core "DevLog" entries — knowledge sharing records.
model SolutionEntry {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  authorId     String?  @map("author_id")
  status       String   @default("in-progress")   // "resolved" | "in-progress"
  title        String
  module       String
  errorMessage String?  @map("error_message")
  explanation  String
  codeSnippet  String?  @map("code_snippet")
  createdAt    DateTime @default(now())            @map("created_at")

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("solution_entries")
}

// ── Bug Reports ───────────────────────────────────────────────────────────────
model BugReport {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  title            String
  description      String?
  stepsToReproduce String?  @map("steps_to_reproduce")
  expectedBehavior String?  @map("expected_behavior")
  actualBehavior   String?  @map("actual_behavior")
  severity         String                          // "critical" | "high" | "medium" | "low"
  priority         String                          // "urgent" | "high" | "normal" | "low"
  status           String   @default("open")       // "open" | "in-review" | "resolved" | "closed"
  module           String
  assigneeId       String?  @map("assignee_id")
  reportedById     String?  @map("reported_by_id")
  screenshotNote   String?  @map("screenshot_note")
  createdAt        DateTime @default(now())        @map("created_at")
  updatedAt        DateTime @updatedAt             @map("updated_at")

  project          Project @relation(fields: [projectId],    references: [id], onDelete: Cascade)
  assignee         User?   @relation("assignee", fields: [assigneeId],   references: [id], onDelete: SetNull)
  reporter         User?   @relation("reporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@map("bug_reports")
}

// ── Knowledge Links ───────────────────────────────────────────────────────────
// Embedded Google Docs / Sheets / Word / PDF links — no file storage needed!
model KnowledgeLink {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  title       String
  url         String
  description String?
  type        String   @default("other")           // "google_sheet" | "google_doc" | "word_doc" | "pdf" | "other"
  category    String   @default("General")
  addedById   String?  @map("added_by_id")
  createdAt   DateTime @default(now())             @map("created_at")

  team        Team  @relation(fields: [teamId],    references: [id], onDelete: Cascade)
  addedBy     User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@map("knowledge_links")
}

// ── Chat Messages ─────────────────────────────────────────────────────────────
// Per-project group chat messages.
model ChatMessage {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  authorId  String?  @map("author_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?   @relation(fields: [authorId],  references: [id], onDelete: SetNull)

  @@map("chat_messages")
}
